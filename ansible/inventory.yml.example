all:
  children:
    dev:
      hosts:
        todo-dev:
          ansible_host: DEV_PUBLIC_IP
          ansible_user: ec2-user
          ansible_ssh_private_key_file: /path/to/todo-ec2-key.pem
          ansible_ssh_common_args: -o IdentitiesOnly=yes
    prod:
      hosts:
        todo-prod:
          ansible_host: PROD_PUBLIC_IP
          ansible_user: ec2-user
          ansible_ssh_private_key_file: /path/to/todo-ec2-key.pem
          ansible_ssh_common_args: -o IdentitiesOnly=yes
